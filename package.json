{
  "name": "chto-prigotovit",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "description": "PWA WhatToCook: подбор блюд, поиск по продуктам, рецепты офлайн",
  "scripts": {
    "dev": "npm run data && vite",
    "start": "npm run dev",
    "data": "node scripts/build-data.mjs",
    "validate": "node scripts/build-data.mjs --check",
    "audit": "node scripts/audit-nutrition.mjs",
    "photos": "node scripts/fetch-photos.mjs",
    "icons": "node scripts/make-icons.mjs",
    "test": "npm run data && vitest run",
    "build": "npm run data && npm run audit && tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
